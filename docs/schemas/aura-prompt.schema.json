{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "lmlm_action": {
      "type": "string",
      "enum": ["invoke_vision", "text_generate", "tool_dispatch", "state_checkpoint", "halt"]
    },
    "context_id": {
      "type": "string",
      "description": "Unique session token for the current execution thread."
    },
    "parameters": {
      "type": "object",
      "description": "Dynamic payload required by the selected Lmlm sub-module."
    }
  },
  "required": ["lmlm_action", "context_id"]
}
