{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/web4hub/awesome-ai-prompts/blob/main/schemas/aura-prompt.schema.json",
  "title": "Aura Prompt Specification",
  "description": "Machine-readable metadata contract for APS-1.0 prompt documents.",
  "type": "object",
  "required": ["id", "name", "version", "author", "ecosystem", "target_engine", "tags"],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "name": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "author": { "type": "string", "minLength": 1 },
    "ecosystem": { "type": "string", "minLength": 1 },
    "target_engine": { "type": "string", "minLength": 1 },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "parameters": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "temperature": { "type": "number", "minimum": 0 },
        "max_tokens": { "type": "integer", "minimum": 1 },
        "top_p": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
